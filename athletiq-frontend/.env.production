# Django backend configuration for production
REACT_APP_API_URL=https://your-production-domain.com
REACT_APP_ENV=production

# Build optimization
GENERATE_SOURCEMAP=false

# Essential third-party services (configure with actual production values)
REACT_APP_GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key

# Optional services - uncomment and configure if needed
# REACT_APP_GOOGLE_ANALYTICS_ID=your_production_ga_id
# REACT_APP_SENTRY_DSN=your_production_sentry_dsn
# REACT_APP_GOOGLE_CLIENT_ID=your_production_google_oauth_client_id

# Development/testing features (should be false in production)
# REACT_APP_DEMO_MODE=false